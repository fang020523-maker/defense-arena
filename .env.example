# ============================================================
# 赛博答辩厅 Defense Arena - 环境变量模板
# 复制本文件为 .env 并按需填写（均为可选项）
# ============================================================

# 本地代理服务端口（默认 3001）
PORT=3001

# 可选：服务端默认 DeepSeek API Key。
# 若不填，用户在前端「设置」中填入自己的 Key 即可（推荐，评委复现更方便）。
# 获取地址：https://platform.deepseek.com
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
